# Como ya aparece en las primeras tablas se debe primero borrar:

DROP USER 'editor_grupo'@'localhost';

# Se vuelve a crear otra vez

CREATE USER 'editor_grupo'@'localhost' IDENTIFIED BY '12345';

# Se generan los permisos del Usuario 

GRANT SELECT, INSERT, UPDATE, DELETE
ON biblioteca_db.*
TO 'editor_grupo'@'localhost';

# Se actulizan y verifican 

FLUSH PRIVILEGES;

SHOW GRANTS FOR 'editor_grupo'@'localhost';


